[Desktop Entry]
Type=Application
Version=1.0
Name=晏阳社区
Name[zh_CN]=晏阳社区
GenericName=社区客户端
Comment=晏阳社区桌面客户端
Comment[zh_CN]=晏阳社区桌面客户端
Exec=ycomm_client %U
Icon=ycomm
Terminal=false
Categories=Network;InstantMessaging;
